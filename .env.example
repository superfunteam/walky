# Netlify: Project configuration > Environment variables > Functions scope.
# Never prefix these with VITE_; none belong in a browser bundle.
# Generate a private connection code: openssl rand -hex 32
WALKY_TOKEN=
WALKY_TIMEZONE=America/Chicago

# International format recommended; no spaces, parentheses or dashes.
CLARK=
ANGIE=
# Textbelt API key. TEXTBELT is also accepted; TEXBELT takes precedence.
TEXBELT=
# false pauses reminders; true enables them when all three values exist.
SMS_ENABLED=true
